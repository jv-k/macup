{
  "name": "macup",
  "version": "1.0.0",
  "description": "A plugin-based CLI for tracking and updating developer packages on macOS — Homebrew, npm, App Store, Xcode, and system updates with pins, skip lists, and an interactive wizard.",
  "type": "module",
  "bin": {
    "macup": "./dist/cli.mjs"
  },
  "main": "./dist/cli.mjs",
  "exports": {
    ".": "./dist/cli.mjs",
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.mjs",
      "default": "./dist/meta.mjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE.md"],
  "engines": {
    "node": ">=20"
  },
  "os": ["darwin"],
  "preferGlobal": true,
  "keywords": [
    "macos",
    "package-manager",
    "homebrew",
    "npm",
    "app-store",
    "xcode",
    "automation",
    "cli",
    "maintenance"
  ],
  "author": "John Valai <git@jvk.to>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jv-k/macup.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/jv-k/macup/issues"
  },
  "homepage": "https://github.com/jv-k/macup",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsup --watch --onSuccess 'echo built'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun scripts/build-binary.ts",
    "screenshots": "./dev/screenshots.sh",
    "screenshots:help": "./dev/screenshots.sh help",
    "screenshots:demo": "./dev/screenshots.sh demo",
    "prepack": "cp ../../README.md ../../LICENSE.md .",
    "postpack": "rm -f README.md LICENSE.md"
  },
  "dependencies": {
    "@clack/core": "1.2.0",
    "@clack/prompts": "^1.2.0",
    "citty": "^0.1.6",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "node-pty": "^1.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
