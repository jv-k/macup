{
  "name": "macup-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "turbo run build",
    "build:binary": "turbo run build:binary",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "adr:check": "node scripts/check-adrs.mjs",
    "screenshots": "./apps/cli/dev/screenshots.sh",
    "screenshots:help": "./apps/cli/dev/screenshots.sh help",
    "screenshots:demo": "./apps/cli/dev/screenshots.sh demo",
    "screenshots:wizard": "./apps/cli/dev/screenshots.sh wizard",
    "shellcheck": "git ls-files '*.sh' | xargs shellcheck --severity=warning",
    "deslop:lint": "uvx --from git+https://github.com/jv-k/deslopper@038e6b5170b4d5d97eff143a17475181d73aea99 deslopper lint",
    "prepare": "simple-git-hooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' '*.markdown' '*.mdx' | grep -Ev '(^|/)(node_modules|\\.github/chatmodes|docs/superpowers|\\.worktrees)/' || true); [ -z \"$FILES\" ] && exit 0; echo \"$FILES\" | xargs env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE pnpm deslop:lint"
  }
}
