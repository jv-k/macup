{
  "name": "macup",
  "version": "1.0.0",
  "description": "A plugin-based CLI for tracking and updating developer packages on macOS — Homebrew, npm, App Store, Xcode, and system updates with pins, skip lists, and an interactive wizard.",
  "type": "module",
  "bin": {
    "macup": "./dist/cli.mjs"
  },
  "main": "./dist/cli.mjs",
  "exports": {
    ".": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun scripts/build-binary.ts"
  },
  "keywords": [
    "macos",
    "package-manager",
    "homebrew",
    "npm",
    "app-store",
    "xcode",
    "automation",
    "cli",
    "maintenance"
  ],
  "author": "John Valai <git@jvk.to>",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jv-k/macos-updatetool.git"
  },
  "bugs": {
    "url": "https://github.com/jv-k/macos-updatetool/issues"
  },
  "homepage": "https://github.com/jv-k/macos-updatetool",
  "preferGlobal": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@clack/prompts": "^1.2.0",
    "citty": "^0.1.6",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
