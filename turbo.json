{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:binary": {
      "dependsOn": ["build"],
      "outputs": ["dist/macup-*", "dist/checksums.txt"]
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["build"]
    }
  }
}
