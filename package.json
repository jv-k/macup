{
  "name": "macup",
  "version": "0.1.0-dev.0",
  "description": "A CLI workflow tool designed to make updating essential resources important for developers working in a macOS environment frictionless. It handles Homebrew, npm, App Store apps, as well as Xcode resource types.",
  "type": "module",
  "bin": {
    "macup-next": "./dist/cli.mjs"
  },
  "main": "./dist/cli.mjs",
  "exports": {
    ".": "./dist/cli.mjs"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun scripts/build-binary.ts"
  },
  "keywords": [
    "macos",
    "package-manager",
    "homebrew",
    "npm",
    "app-store",
    "xcode",
    "automation",
    "cli",
    "maintenance"
  ],
  "author": "John Valai <git@jvk.to>",
  "license": "MIT",
  "os": ["darwin"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jv-k/macos-updatetool.git"
  },
  "bugs": {
    "url": "https://github.com/jv-k/macos-updatetool/issues"
  },
  "homepage": "https://github.com/jv-k/macos-updatetool",
  "preferGlobal": true,
  "dependencies": {
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
